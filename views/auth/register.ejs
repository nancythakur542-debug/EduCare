<div class="row justify-content-center py-5">
    <div class="col-md-6">
        <div class="card p-4">
            <h2 class="h4 fw-bold mb-4 text-center">Create Student Account</h2>
            <% if (error) { %>
                <div class="alert alert-danger py-2 small">
                    <%= error %>
                </div>
                <% } %>
                    <form action="/auth/register" method="POST">
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Full Name</label>
                            <input type="text" name="name" class="form-control" value="<%= oldInput.name || '' %>"
                                required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Email Address</label>
                            <input type="email" name="email" class="form-control" value="<%= oldInput.email || '' %>"
                                required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Password (min 6 characters)</label>
                            <input type="password" name="password" class="form-control" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Department / Stream</label>
                            <input type="text" name="department" class="form-control"
                                value="<%= oldInput.department || '' %>">
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Student ID</label>
                            <input type="text" name="studentId" class="form-control"
                                value="<%= oldInput.studentId || '' %>">
                        </div>
                        <button type="submit" class="btn btn-sage w-100 mb-3">Register</button>
                        <p class="text-center small mb-0">Already have an account? <a href="/auth/login">Sign In</a></p>
                    </form>
        </div>
    </div>
</div>