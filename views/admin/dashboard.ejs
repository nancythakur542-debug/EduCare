<div class="row mb-4">
    <div class="col-12">
        <div class="card p-4">
            <h1 class="h3 fw-bold mb-1">Administrator Institutional Dashboard</h1>
            <p class="text-muted mb-0">Anonymized institutional well-being trends and usage statistics.</p>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-3 mb-3">
        <div class="card p-3">
            <h6 class="text-muted small fw-semibold">Total Students</h6>
            <h3 class="fw-bold">
                <%= totalStudents %>
            </h3>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card p-3">
            <h6 class="text-muted small fw-semibold">Total Counsellors</h6>
            <h3 class="fw-bold">
                <%= totalCounsellors %>
            </h3>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card p-3">
            <h6 class="text-muted small fw-semibold">Total Appointments</h6>
            <h3 class="fw-bold">
                <%= totalAppointments %>
            </h3>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card p-3">
            <h6 class="text-muted small fw-semibold">Active Risk Alerts</h6>
            <h3 class="fw-bold text-danger">
                <%= activeAlerts %>
            </h3>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-4">
        <div class="card p-4">
            <h2 class="h5 fw-bold mb-3">Institutional Averages</h2>
            <ul class="list-group list-group-flush">
                <li class="list-group-item d-flex justify-content-between align-items-center">Average Stress Level <span
                        class="badge bg-primary">
                        <%= averages.avgStress ? averages.avgStress.toFixed(1) : 0 %>/5
                    </span></li>
                <li class="list-group-item d-flex justify-content-between align-items-center">Average Sleep Quality
                    <span class="badge bg-primary">
                        <%= averages.avgSleep ? averages.avgSleep.toFixed(1) : 0 %>/5
                    </span></li>
                <li class="list-group-item d-flex justify-content-between align-items-center">Average Academic Pressure
                    <span class="badge bg-primary">
                        <%= averages.avgAcademic ? averages.avgAcademic.toFixed(1) : 0 %>/5
                    </span></li>
            </ul>
        </div>
    </div>
</div>