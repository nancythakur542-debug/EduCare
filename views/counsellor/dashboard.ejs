<div class="row mb-4">
    <div class="col-12">
        <div class="card p-4">
            <h1 class="h3 fw-bold mb-1">Counsellor Dashboard</h1>
            <p class="text-muted mb-0">Review appointments, risk alerts, and student check-ins.</p>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-6 mb-4">
        <div class="card p-4">
            <h2 class="h5 fw-bold mb-3">Pending Risk Alerts</h2>
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th>Student</th>
                            <th>Level</th>
                            <th>Reason</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% riskAlerts.forEach(alert=> { %>
                            <tr>
                                <td>
                                    <%= alert.student.name %>
                                </td>
                                <td><span class="badge bg-danger">Level <%= alert.riskLevel %></span></td>
                                <td>
                                    <%= alert.reason %>
                                </td>
                                <td>
                                    <form action="/counsellor/alerts/<%= alert._id %>" method="POST"
                                        class="d-flex gap-1">
                                        <input type="hidden" name="reviewStatus" value="Reviewed">
                                        <input type="text" name="counsellorNotes" class="form-control form-control-sm"
                                            placeholder="Notes" required>
                                        <button type="submit" class="btn btn-sm btn-sage">Resolve</button>
                                    </form>
                                </td>
                            </tr>
                            <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-6 mb-4">
        <div class="card p-4">
            <h2 class="h5 fw-bold mb-3">Upcoming Appointments</h2>
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th>Student</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th>Update</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% appointments.forEach(app=> { %>
                            <tr>
                                <td>
                                    <%= app.student.name %>
                                </td>
                                <td>
                                    <%= new Date(app.date).toLocaleDateString() %> (<%= app.timeSlot %>)
                                </td>
                                <td>
                                    <%= app.status %>
                                </td>
                                <td>
                                    <form action="/counsellor/appointments/<%= app._id %>" method="POST"
                                        class="d-flex gap-1">
                                        <select name="status" class="form-select form-select-sm">
                                            <option value="Scheduled">Scheduled</option>
                                            <option value="Completed">Completed</option>
                                            <option value="Cancelled">Cancelled</option>
                                        </select>
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">Save</button>
                                    </form>
                                </td>
                            </tr>
                            <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card p-4">
            <h2 class="h5 fw-bold mb-3">Assigned Students</h2>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Department</th>
                            <th>Student ID</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% assignedStudents.forEach(st=> { %>
                            <tr>
                                <td>
                                    <%= st.name %>
                                </td>
                                <td>
                                    <%= st.email %>
                                </td>
                                <td>
                                    <%= st.department || '-' %>
                                </td>
                                <td>
                                    <%= st.studentId || '-' %>
                                </td>
                                <td><a href="/counsellor/students/<%= st._id %>"
                                        class="btn btn-sm btn-outline-secondary">View Records</a></td>
                            </tr>
                            <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>